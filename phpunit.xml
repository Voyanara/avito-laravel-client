<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.3/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true" stopOnFailure="true" cacheResult="false"
         defaultTestSuite="Unit"
>
    <testsuites>
        <!-- Offline tests with a faked Avito API: no credentials needed, run in CI. -->
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <!-- Live tests against the real Avito API: composer test:live -->
        <testsuite name="Live">
            <directory suffix="Test.php">./tests/Application</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">./app</directory>
            <directory suffix=".php">./src</directory>
        </include>
    </source>
</phpunit>
