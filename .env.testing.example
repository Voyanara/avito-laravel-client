# Used only by the live tests: ./vendor/bin/pest --testsuite=Live
# The offline tests (./vendor/bin/pest) need nothing from this file.

AVITO_API_URL=https://api.avito.ru
AVITO_CLIENT_ID=
AVITO_SECRET=
AVITO_TOKEN_STORAGE=database
TOKEN_FILE_NAME=test-token

# Your Avito user ID (user()->self()->id). Needed to send messages, images, voice and blacklist tests.
DEMO_SENDER=
# A chat the tests may write to: they send and delete real messages there.
DEMO_CHAT_ID=
# Optional: voice_id of a voice message in a chat (getVoiceFiles test).
DEMO_VOICE_ID=
# Optional: a dedicated test user to block. Blocking cannot be undone via the API.
DEMO_BLACKLIST_USER_ID=
