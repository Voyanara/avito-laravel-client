{
    "name": "voyanara/avito-laravel-client",
    "description": "Typed Laravel SDK for the Avito API (Авито): messenger, webhooks, account balance and operations, with automatic OAuth token handling.",
    "type": "library",
    "keywords": ["laravel", "avito", "avito-api", "avito-messenger", "авито", "api-client", "sdk", "laravel-package", "webhooks", "php"],
    "homepage": "https://github.com/Voyanara/avito-laravel-client",
    "support": {
        "issues": "https://github.com/Voyanara/avito-laravel-client/issues",
        "source": "https://github.com/Voyanara/avito-laravel-client"
    },
    "require": {
        "php": "^8.3",
        "spatie/laravel-data": "^4.23",
        "laravel/framework": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3|^12.0",
        "orchestra/testbench": "^9.4|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0",
        "rector/rector": "^1.2|^2.0",
        "laravel/pint": "^1.17",
        "larastan/larastan": "^3.10"
    },
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Voyanara\\LaravelApiClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Voyanara\\LaravelApiClient\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Kitsen Artem"
        }
    ],
    "scripts": {
        "test": "pest",
        "test:live": "pest --testsuite=Live",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Voyanara\\LaravelApiClient\\Infrastructure\\Providers\\AvitoModuleServiceProvider"
            ],
            "aliases": {
                "AvitoClient": "Voyanara\\LaravelApiClient\\Application\\Facades\\AvitoClientFacade"
            }
        }
    }
}
