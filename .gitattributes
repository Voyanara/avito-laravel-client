# LF everywhere, also in Windows checkouts (core.autocrlf=true would give CRLF,
# and Pint then reports line_ending on every file).
* text=auto eol=lf

*.md diff=markdown
*.php diff=php

# Not shipped in the package installed by Composer (dist archive).
/.github export-ignore
/tests export-ignore
/.env.testing.example export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/makefile export-ignore
/phpstan.neon export-ignore
/phpunit.xml export-ignore
/pint.json export-ignore
/rector.php export-ignore
